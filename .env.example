# Copy this file to .env and fill in your values

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# SQLite (default for development — no MySQL required)
# DATABASE_URL=sqlite:///sapes_dev.db

# MySQL — Windows (uses PyMySQL, no C libraries needed)
# DATABASE_URL=mysql+pymysql://sapes_user:password@localhost/sapes_db
# MySQL — Linux/macOS production (uses mysqlclient C driver, faster)
# DATABASE_URL=mysql+mysqlclient://sapes_user:password@localhost/sapes_db

# Email (optional — in-app notifications work without email)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
